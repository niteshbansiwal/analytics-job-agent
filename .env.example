# LOCAL: set DEMO_MODE=true to explore using clearly labelled fictional sample jobs.
DEMO_MODE=true
# When connected/live, set DEMO_MODE=false and require these:
DATABASE_URL=sqlite:///./data/agent.db
APP_BASE_URL=http://localhost:8000
ALLOWED_GOOGLE_EMAIL=you@gmail.com
GOOGLE_CLIENT_ID=replace_with_google_oauth_client_id
GOOGLE_CLIENT_SECRET=replace_with_google_oauth_client_secret
SESSION_SECRET=replace_with_a_long_random_64_character_hex_string
TOKEN_ENCRYPTION_KEY=replace_with_fernet_generate_key
SERPER_API_KEY=replace_with_your_search_api_key
ROCKETREACH_API_KEY=replace_with_rocketreach_api_key
TELEGRAM_BOT_TOKEN=replace_with_botfather_token
TELEGRAM_CHAT_ID=replace_with_your_telegram_chat_id
TELEGRAM_WEBHOOK_SECRET=replace_with_a_random_secret
OPENAI_API_KEY=replace_with_your_api_key
OPENAI_MODEL=gpt-4.1-mini
CRON_SECRET=replace_with_long_random_string
# Never send until you edit config/settings.yaml and opt in.
